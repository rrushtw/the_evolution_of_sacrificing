# Copy to .env and tweak. Both docker-compose and devcontainer read this file.
#
# .env is gitignored — never commit secrets or per-machine overrides.
# .env.example IS committed — keep it in sync as the public schema.
#
# IMPORTANT: no inline comments. Docker Engine's --env-file parser (used by the
# devcontainer) does NOT strip a trailing "# ..." — it becomes part of the
# value and breaks float()/int() parsing. Keep every comment on its own line.

# --- Noise ---
# NOISE_RATE: external — signal lost / accidental alert.
NOISE_RATE=0.01
# INTERNAL_NOISE_RATE: internal — slip of tongue (treated as intent).
INTERNAL_NOISE_RATE=0.02

# --- Alarm Call mechanics ---
PROB_SPOT_DANGER=0.5
SURVIVAL_SPOTTER_NOTIFY=0.9
SURVIVAL_SPOTTER_RUN=1.0
SURVIVAL_LISTENER_WARNED=1.0
SURVIVAL_LISTENER_IGNORANT=0.05

# --- Evolution (capital + overlapping generations) ---
# INITIAL_COPIES: copies per strategy → N = strategies × this.
INITIAL_COPIES=10
# ENCOUNTERS_PER_AGENT: ~interactions per agent each round.
ENCOUNTERS_PER_AGENT=2
# CAPITAL_BASELINE: starting capital, and the level agents recover toward.
# Keep well above a single hit (IGNORANT = −0.95) so a bad encounter hurts
# but rarely bankrupts in one round → long, graded lives.
CAPITAL_BASELINE=5.0
# CAPITAL_RECOVERY: fraction of the gap to baseline healed per round.
# Lower = a loss lingers longer = a longer shadow of the future.
CAPITAL_RECOVERY=0.1
# BASE_DEATH / AGE_DEATH: per-round mortality = BASE_DEATH + AGE_DEATH×age
# (plus instant death on bankruptcy). Tuned for long-but-finite lives.
BASE_DEATH=0.002
AGE_DEATH=0.0010
# ASSORTMENT: when forming a NEW tie, P(prefer a same-Standing partner).
ASSORTMENT=0.0
MAX_GENERATIONS=3000

# --- Social network (Stage B) ---
# AVG_DEGREE: contacts per agent (interactions are drawn between contacts).
AVG_DEGREE=6
# CHURN_RATE: per-round P(a tie reshuffles). Village↔metropolis dial:
# 0 = keep your circle for life (private history rules);
# →1 = constant reshuffle (you face strangers → reputation rules).
# (Exploiting a GOOD contact always breaks that tie regardless — the
#  exploiter flees, escaping private revenge.)
CHURN_RATE=0.05

# --- Knockout flags (private-vs-public causal experiments) ---
# 1 = ablate that channel. BLIND_REPUTATION: deciders always see GOOD.
# BLIND_PRIVATE: per-opponent memory is never recorded.
BLIND_REPUTATION=0
BLIND_PRIVATE=0

# --- Stability ---
# Stable = each species' count fluctuates by ≤ TOLERANCE over a window
# of THRESHOLD generations.
STABILITY_THRESHOLD=100
STABILITY_TOLERANCE=5

# --- Runtime / UI ---
# VERBOSE: 1 = print every generation's full leaderboard.
VERBOSE=0
# PYTHONUNBUFFERED: immediate stdout flush (don't change unless you know why).
PYTHONUNBUFFERED=1
