# Copy to .env and tweak. Both docker-compose and devcontainer read this file.
#
# .env is gitignored — never commit secrets or per-machine overrides.
# .env.example IS committed — keep it in sync as the public schema.
#
# IMPORTANT: no inline comments. Docker Engine's --env-file parser (used by the
# devcontainer) does NOT strip a trailing "# ..." — it becomes part of the
# value and breaks float()/int() parsing. Keep every comment on its own line.

# --- Noise ---
# NOISE_RATE: external — signal lost / accidental alert.
NOISE_RATE=0.01
# INTERNAL_NOISE_RATE: internal — slip of tongue (treated as intent).
INTERNAL_NOISE_RATE=0.02

# --- Alarm Call mechanics ---
PROB_SPOT_DANGER=0.5
SURVIVAL_SPOTTER_NOTIFY=0.9
SURVIVAL_SPOTTER_RUN=1.0
SURVIVAL_LISTENER_WARNED=1.0
SURVIVAL_LISTENER_IGNORANT=0.05

# --- Evolution (well-mixed, death-based selection) ---
# INITIAL_COPIES: copies per strategy → N = strategies × this.
INITIAL_COPIES=10
# SURVIVAL_FLOOR_FRAC: stop a gen once this fraction is still alive
# (caps mortality; lower = crueler environment).
SURVIVAL_FLOOR_FRAC=0.5
# MAX_ENCOUNTERS_PER_AGENT: safety cap on interactions/agent/gen (one-shot).
MAX_ENCOUNTERS_PER_AGENT=4
# ASSORTMENT: P(encounter is same-Standing). 0=well-mixed baseline;
# 1=GOOD only meets GOOD (cooperators cluster).
ASSORTMENT=0.0
MAX_GENERATIONS=3000

# --- Stability ---
# Stable = each species' count fluctuates by ≤ TOLERANCE over a window
# of THRESHOLD generations.
STABILITY_THRESHOLD=100
STABILITY_TOLERANCE=5

# --- Runtime / UI ---
# VERBOSE: 1 = print every generation's full leaderboard.
VERBOSE=0
# PYTHONUNBUFFERED: immediate stdout flush (don't change unless you know why).
PYTHONUNBUFFERED=1
